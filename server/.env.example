# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Berapa kali permintaan ke Gemini dicoba (termasuk percobaan pertama) kalau
# balasannya 503 "high demand" / 429 / 5xx. Jeda antar percobaan naik 1s -> 8s.
GEMINI_RETRY_ATTEMPTS=4

# --- Siapa yang boleh menyuruh bot ---
# Nomor pengirim yang diizinkan, pisahkan koma. Format bebas (+62.., 08..).
# Kosongkan kalau HANYA mau pakai chat ke diri sendiri.
WHITELIST=
# Izinkan pesan dari "Message Yourself" (chat ke nomor sendiri). Ini cara paling praktis.
ALLOW_SELF_CHAT=true

# --- Filter kata kunci ---
# true = hanya pesan berawalan salah satu KEYWORDS yang diproses (disarankan,
# supaya obrolan biasa tidak ikut dikirim ke Gemini).
REQUIRE_KEYWORD=true
KEYWORDS=/catat,/ingatkan,/note

# --- Waktu ---
TIMEZONE=Asia/Jakarta
# Alarm default, dipakai HANYA kalau pesannya tidak menyebut sendiri.
# Contoh pesan yang menimpa nilai ini: "ingetin 2 jam sebelumnya", "pas jamnya".
# 0 = alarm tepat saat acara mulai. Maksimum 10080 (7 hari).
REMINDER_MINUTES_BEFORE=30

# --- CalDAV (Radicale) ---
CALDAV_URL=http://localhost:5232/
CALDAV_USERNAME=yusuf
CALDAV_PASSWORD=
# Nama kalender tujuan. Kosong = pakai kalender pertama yang ditemukan.
CALDAV_CALENDAR=

# --- Lain-lain ---
DATA_DIR=./data
LOG_LEVEL=info
# Log internal Baileys sangat berisik di level info. Naikkan ke info/debug
# hanya kalau sedang mendiagnosis masalah koneksi WhatsApp.
BAILEYS_LOG_LEVEL=warn
