[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
# bcrypt = hash aman. Buat dengan: htpasswd -B -c users <nama>
htpasswd_encryption = bcrypt

[storage]
filesystem_folder = /data/collections

[web]
# Matikan web UI. Radicale diakses dari internet lewat Cloudflare Tunnel, dan
# DAVx5 cuma butuh CalDAV (PROPFIND/REPORT), bukan halaman /.web. Koleksi
# "Reminder" sudah dibuat, jadi UI tidak diperlukan lagi.
type = none

[logging]
level = info
